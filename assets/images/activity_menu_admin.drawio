        <!-- Simpan -> File? -->
        <mxCell id="edge_simpan_file" edge="1" parent="1" source="act_simpan" target="dec_file" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
