        <mxCell id="label_pesanan_mult2" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Arial;fontSize=11;" vertex="1" connectable="0" parent="edge_pesanan_detail">
          <mxGeometry relative="1" x="-0.85" y="10" as="geometry" />
