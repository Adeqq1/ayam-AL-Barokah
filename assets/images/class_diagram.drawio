        <mxCell id="label_detail_mult" value="1..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Arial;fontSize=11;" vertex="1" connectable="0" parent="edge_pesanan_detail">
          <mxGeometry relative="1" x="0.85" y="10" as="geometry" />
        </mxCell>
        
        <!-- Edge 3: Menu "1" -> "0..*" DetailPesanan (Association) -->
        <mxCell id="edge_menu_detail" value="terdaftar_pada" style="endArrow=open;endSize=12;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontFamily=Arial;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="class_menu" target="class_detail_pesanan">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
