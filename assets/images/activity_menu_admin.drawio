        <mxCell id="act_isi" value="Mengisi Form Menu &amp; Unggah Foto Produk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="10" y="270" width="140" height="50" as="geometry" />
