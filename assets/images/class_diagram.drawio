          <mxGeometry relative="1" x="0.85" y="-10" as="geometry" />
        </mxCell>
        
        <!-- Edge 2: Pesanan "1" -> "1..*" DetailPesanan (Association) -->
        <mxCell id="edge_pesanan_detail" value="memiliki" style="endArrow=open;endSize=12;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontFamily=Arial;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="class_pesanan" target="class_detail_pesanan">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
