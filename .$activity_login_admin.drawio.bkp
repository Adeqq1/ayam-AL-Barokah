          <mxGeometry x="100" y="510" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Redirect Dashboard -->
        <mxCell id="act_redirect" value="Mengarahkan ke Dashboard Admin (admin/index.php)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="590" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Memuat Dashboard -->
        <mxCell id="act_dashboard" value="Sistem Memuat Panel Dashboard" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="670" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State -->
