          <mxGeometry x="180" y="740" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <!-- Start -> Akses -->
        <mxCell id="edge_start_akses" edge="1" parent="1" source="start" target="act_akses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Akses -> Tampil Form -->
        <mxCell id="edge_akses_tampil" edge="1" parent="1" source="act_akses" target="act_tampil_form" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Tampil Form -> Input -->
        <mxCell id="edge_tampil_input" edge="1" parent="1" source="act_tampil_form" target="act_input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Input -> Klik -->
        <mxCell id="edge_input_klik" edge="1" parent="1" source="act_input" target="act_klik" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Klik -> Sanitasi -->
        <mxCell id="edge_klik_sanitasi" edge="1" parent="1" source="act_klik" target="act_sanitasi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Sanitasi -> Decision -->
        <mxCell id="edge_sanitasi_valid" edge="1" parent="1" source="act_sanitasi" target="dec_valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Decision -> Error (Tidak) -->
        <mxCell id="edge_valid_error" edge="1" parent="1" source="dec_valid" target="act_error" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value="Tidak">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Error -> Tampil Form (Loop back) -->
        <mxCell id="edge_error_tampil" edge="1" parent="1" source="act_error" target="act_tampil_form" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;">
          <mxGeometry relative="1" as="geometry">
            <Array points="560,390;500,390;500,260;660,260" />
          </mxGeometry>
        </mxCell>
        
        <!-- Decision -> Session (Ya) -->
