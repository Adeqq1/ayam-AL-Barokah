<mxfile host="Electron" agent="5.0 (Windows)">
  <diagram id="activity-admin-login" name="Activity Diagram Login Admin">
    <mxGraphModel dx="1046" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Swimlane Pool -->
        <mxCell id="swimlane_pool" value="Activity Diagram: Login Admin" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=40;swimlaneFillColor=#FFFFFF;fontStyle=1;align=center;fontSize=14;strokeWidth=2;rounded=1;arcSize=10;fontFamily=Times New Roman;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="700" height="820" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Admin -->
        <mxCell id="swimlane_admin" value="Admin" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="0" y="40" width="320" height="780" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Sistem -->
        <mxCell id="swimlane_sistem" value="Sistem" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="320" y="40" width="380" height="780" as="geometry" />
        </mxCell>
        
        <!-- Start State -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="150" y="30" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Akses Halaman Login -->
        <mxCell id="act_akses" value="Mengakses halaman login.php" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Tampilkan Form Login -->
        <mxCell id="act_tampil_form" value="Menampilkan Form Login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Input Username & Password -->
        <mxCell id="act_input" value="Memasukkan Username &amp; Password" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="160" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Klik Login -->
        <mxCell id="act_klik" value="Menekan Tombol Login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="240" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Sanitasi & Validasi -->
        <mxCell id="act_sanitasi" value="Melakukan Sanitasi Input &amp; Validasi Kredensial" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="240" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision Node -->
