# ==========================================
# Ayam AL Barokah - Environment Configuration
# ==========================================

# Mode: 'local' (Laragon) atau 'production' (Docker VPS)
APP_ENV=local
APP_DEBUG=true

# URL Aplikasi
# - Di Laragon: http://ayam-al-barokah.test atau http://localhost/ayam-AL-Barokah
# - Di VPS:     https://al-barokah.web.id
APP_URL=http://ayam-al-barokah.test

# ------------------------------------------
# Pengaturan Database MySQL:
# - Untuk Laragon (Local): DB_HOST=127.0.0.1, DB_USERNAME=root, DB_PASSWORD=
# - Untuk Docker (VPS):   DB_HOST=mysql_shared, DB_USERNAME=albarokah_user, DB_PASSWORD=AlBarokahSecret2026!
# ------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_pemesanan
DB_USERNAME=root
DB_PASSWORD=
