          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Redirect -> Dashboard -->
        <mxCell id="edge_redirect_dashboard" edge="1" parent="1" source="act_redirect" target="act_dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Dashboard -> End -->
        <mxCell id="edge_dashboard_end" edge="1" parent="1" source="act_dashboard" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
