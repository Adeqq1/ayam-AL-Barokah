<mxfile host="Electron" agent="5.0 (Windows)">
  <diagram id="activity-admin-logout" name="Activity Diagram Logout Admin">
    <mxGraphModel dx="1046" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Swimlane Pool -->
        <mxCell id="swimlane_pool" value="Activity Diagram: Logout Admin" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=40;swimlaneFillColor=#FFFFFF;fontStyle=1;align=center;fontSize=14;strokeWidth=2;rounded=1;arcSize=10;fontFamily=Times New Roman;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="700" height="520" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Admin -->
        <mxCell id="swimlane_admin" value="Admin" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="0" y="40" width="320" height="480" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Sistem -->
        <mxCell id="swimlane_sistem" value="Sistem" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="320" y="40" width="380" height="480" as="geometry" />
        </mxCell>
        
        <!-- Start State -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="150" y="30" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Klik Logout -->
        <mxCell id="act_klik" value="Mengeklik Link Logout pada Sidebar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Popup Konfirmasi -->
        <mxCell id="act_popup" value="Menampilkan Dialog Konfirmasi Keluar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision: Yakin? -->
        <mxCell id="dec_yakin" value="Apakah Yakin Keluar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="90" y="160" width="140" height="80" as="geometry" />
        </mxCell>
        
        <!-- Action: Batal -->
        <mxCell id="act_batal" value="Membatalkan Logout (Tetap berada pada Halaman Panel Admin)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="10" y="270" width="140" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State: Batal -->
        <mxCell id="end_batal" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="350" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Hancurkan Sesi -->
        <mxCell id="act_destroy" value="Mengosongkan Array $_SESSION &amp; Menghancurkan Cookie Sesi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="270" width="180" height="60" as="geometry" />
        </mxCell>
        
        <!-- Action: Redirect index -->
        <mxCell id="act_redirect" value="Mengarahkan Kembali ke Halaman Katalog Pelanggan (index.php)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="360" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State -->
        <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="180" y="440" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <!-- Start -> Akses -->
        <mxCell id="edge_start_akses" edge="1" parent="1" source="start" target="act_klik" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Klik -> Popup -->
        <mxCell id="edge_klik_popup" edge="1" parent="1" source="act_klik" target="act_popup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Popup -> Yakin? -->
        <mxCell id="edge_popup_yakin" edge="1" parent="1" source="act_popup" target="dec_yakin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array points="340,105;340,145;220,145;220,170" />
          </mxGeometry>
        </mxCell>
        
        <!-- Yakin? -> Batal (Tidak) -->
        <mxCell id="edge_yakin_tidak" edge="1" parent="1" source="dec_yakin" target="act_batal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value="Batal">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Batal -> End Batal -->
        <mxCell id="edge_batal_end" edge="1" parent="1" source="act_batal" target="end_batal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Yakin? -> Hancurkan (Ya) -->
        <mxCell id="edge_yakin_ya" edge="1" parent="1" source="dec_yakin" target="act_destroy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" value="Yakin">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Hancurkan -> Redirect -->
        <mxCell id="edge_destroy_redirect" edge="1" parent="1" source="act_destroy" target="act_redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Redirect -> End -->
        <mxCell id="edge_redirect_end" edge="1" parent="1" source="act_redirect" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>