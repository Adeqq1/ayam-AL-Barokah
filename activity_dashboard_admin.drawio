<mxfile host="Electron" agent="5.0 (Windows)">
  <diagram id="activity-admin-dashboard" name="Activity Diagram Dashboard Admin">
    <mxGraphModel dx="1046" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Swimlane Pool -->
        <mxCell id="swimlane_pool" value="Activity Diagram: Melihat Dashboard &amp; Statistik" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=40;swimlaneFillColor=#FFFFFF;fontStyle=1;align=center;fontSize=14;strokeWidth=2;rounded=1;arcSize=10;fontFamily=Times New Roman;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="700" height="680" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Admin -->
        <mxCell id="swimlane_admin" value="Admin" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="0" y="40" width="320" height="640" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Sistem -->
        <mxCell id="swimlane_sistem" value="Sistem" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="320" y="40" width="380" height="640" as="geometry" />
        </mxCell>
        
        <!-- Start State -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="150" y="30" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Akses Dashboard -->
        <mxCell id="act_akses" value="Mengakses Halaman Dashboard (admin/index.php)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Cek Sesi -->
        <mxCell id="act_cek_sesi" value="Mengecek Sesi Login Admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision: Sesi Aktif? -->
        <mxCell id="dec_sesi" value="Apakah Sesi Aktif?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="120" y="160" width="140" height="80" as="geometry" />
        </mxCell>
        
        <!-- Action: Redirect Login -->
        <mxCell id="act_redirect_login" value="Mengarahkan ke Halaman Login (login.php)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="10" y="270" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State: Login Redirect -->
        <mxCell id="end_login" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="80" y="350" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Query Database -->
        <mxCell id="act_query" value="Query Database:&#xa;- Pendapatan/Omzet&#xa;- Jumlah Pesanan&#xa;- Pesanan Pending&#xa;- Jumlah Menu&#xa;- 5 Transaksi Terbaru" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;align=left;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="190" y="270" width="180" height="90" as="geometry" />
        </mxCell>
        
        <!-- Action: Tampilkan Kartu Statistik -->
        <mxCell id="act_tampil_kartu" value="Menyajikan 4 Kartu Statistik Ringkasan Bisnis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="190" y="390" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Tampilkan Tabel -->
        <mxCell id="act_tampil_tabel" value="Menampilkan Tabel 5 Pesanan Pelanggan Terbaru" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="190" y="470" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Melihat Dashboard -->
        <mxCell id="act_melihat" value="Melihat &amp; Meninjau Dashboard Statistik &amp; Ringkasan Transaksi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="470" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State: Dashboard View -->
        <mxCell id="end_dashboard" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="150" y="560" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <!-- Start -> Akses -->
        <mxCell id="edge_start_akses" edge="1" parent="1" source="start" target="act_akses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Akses -> Cek Sesi -->
        <mxCell id="edge_akses_cek" edge="1" parent="1" source="act_akses" target="act_cek_sesi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Cek Sesi -> Sesi? -->
        <mxCell id="edge_cek_dec" edge="1" parent="1" source="act_cek_sesi" target="dec_sesi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Sesi? -> Redirect (Tidak) -->
        <mxCell id="edge_sesi_tidak" edge="1" parent="1" source="dec_sesi" target="act_redirect_login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value="Tidak">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Redirect -> End Login -->
        <mxCell id="edge_redirect_end" edge="1" parent="1" source="act_redirect_login" target="end_login" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Sesi? -> Query (Ya) -->
        <mxCell id="edge_sesi_ya" edge="1" parent="1" source="dec_sesi" target="act_query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" value="Ya">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Query -> Tampil Kartu -->
        <mxCell id="edge_query_kartu" edge="1" parent="1" source="act_query" target="act_tampil_kartu" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Tampil Kartu -> Tampil Tabel -->
        <mxCell id="edge_kartu_tabel" edge="1" parent="1" source="act_tampil_kartu" target="act_tampil_tabel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Tampil Tabel -> Melihat -->
        <mxCell id="edge_tabel_melihat" edge="1" parent="1" source="act_tampil_tabel" target="act_melihat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Melihat -> End Dashboard -->
        <mxCell id="edge_melihat_end" edge="1" parent="1" source="act_melihat" target="end_dashboard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>