          <mxGeometry height="55" width="135" x="370" y="210" as="geometry" />
        </mxCell>

        <!-- Box 4: Implementasi -->
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=1.5;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;fontColor=#000000;align=center;verticalAlign=middle;" value="Implementasi" vertex="1">
          <mxGeometry height="55" width="135" x="505" y="295" as="geometry" />
