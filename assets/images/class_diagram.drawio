<mxfile host="Electron" agent="5.0 (Windows)">
  <diagram id="class-diagram-barokah" name="Class Diagram Pemesanan Al-Barokah">
    <mxGraphModel dx="1046" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Class: User -->
        <mxCell id="class_user" value="&lt;p align=&quot;center&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;- id&lt;br&gt;- username&lt;br&gt;- password&lt;br&gt;- role (admin, pelanggan)&lt;br&gt;- nama_lengkap&lt;br&gt;- created_at&lt;hr&gt;+ login&lt;br&gt;+ logout&lt;br&gt;+ editProfil&lt;br&gt;+ gantiPassword" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="290" y="40" width="220" height="210" as="geometry" />
        </mxCell>
        
        <!-- Class: Menu -->
        <mxCell id="class_menu" value="&lt;p align=&quot;center&quot;&gt;&lt;b&gt;Menu&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;- id&lt;br&gt;- nama_menu&lt;br&gt;- deskripsi&lt;br&gt;- harga&lt;br&gt;- kategori (makanan, minuman, paket, cemilan)&lt;br&gt;- foto&lt;br&gt;- status (tersedia, habis)&lt;br&gt;- created_at&lt;hr&gt;+ tambahMenu&lt;br&gt;+ editMenu&lt;br&gt;+ hapusMenu" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="260" height="210" as="geometry" />
        </mxCell>
        
        <!-- Class: Pesanan -->
        <mxCell id="class_pesanan" value="&lt;p align=&quot;center&quot;&gt;&lt;b&gt;Pesanan&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;- id&lt;br&gt;- kode_pesanan&lt;br&gt;- user_id&lt;br&gt;- nama_pemesan&lt;br&gt;- no_telepon&lt;br&gt;- alamat&lt;br&gt;- tipe_pesanan (dine_in, take_away, delivery)&lt;br&gt;- total_harga&lt;br&gt;- bukti_pembayaran&lt;br&gt;- status_pembayaran (belum_bayar, menunggu_konfirmasi, lunas, ditolak)&lt;br&gt;- status_pesanan (pending, diproses, selesai, dibatalkan)&lt;br&gt;- tanggal_pesanan&lt;hr&gt;+ buatPesanan&lt;br&gt;+ updateStatusPesanan&lt;br&gt;+ updateStatusPembayaran&lt;br&gt;+ uploadBuktiPembayaran" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="410" y="310" width="320" height="270" as="geometry" />
        </mxCell>
        
        <!-- Class: DetailPesanan -->
        <mxCell id="class_detail_pesanan" value="&lt;p align=&quot;center&quot;&gt;&lt;b&gt;DetailPesanan&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;- id&lt;br&gt;- pesanan_id&lt;br&gt;- menu_id&lt;br&gt;- jumlah&lt;br&gt;- subtotal&lt;hr&gt;+ simpanDetail" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;strokeWidth=1.5;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="240" y="640" width="220" height="150" as="geometry" />
        </mxCell>
        
        <!-- Edge 1: User "1" -> "0..*" Pesanan (Association) -->
        <mxCell id="edge_user_pesanan" value="membuat" style="endArrow=open;endSize=12;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;fontFamily=Arial;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="class_user" target="class_pesanan">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="label_user_mult" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Arial;fontSize=11;" vertex="1" connectable="0" parent="edge_user_pesanan">
