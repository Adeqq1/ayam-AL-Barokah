<style>
  body { font-family: "Times New Roman", Times, serif; font-size: 12pt; line-height: 1.5; }
  h1 { font-size: 14pt; text-align: center; font-weight: bold; text-transform: uppercase; }
  h2 { font-size: 12pt; font-weight: bold; text-transform: uppercase; margin-top: 20px; }
  h3 { font-size: 12pt; font-weight: bold; margin-top: 15px; }
  h4 { font-size: 12pt; font-weight: bold; font-style: italic; margin-top: 10px; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 20px; }
  th, td { border: 1px solid black; padding: 6px; }
  th { background-color: #f2f2f2; font-weight: bold; text-align: left; }
