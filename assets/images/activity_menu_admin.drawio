          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Aksi? -> Hapus -->
        <mxCell id="edge_aksi_hapus" edge="1" parent="1" source="dec_aksi" target="act_hapus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" value="Hapus">
