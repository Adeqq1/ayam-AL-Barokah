<mxfile host="Electron" agent="5.0 (Windows)">
  <diagram id="waterfall-sdlc-model" name="Metode Waterfall SDLC">
    <mxGraphModel dx="1046" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Box 1: Planning -->
        <mxCell id="b1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;strokeWidth=1.5;strokeColor=#000000;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;fontColor=#000000;align=center;verticalAlign=middle;" value="Planning" vertex="1">
          <mxGeometry height="55" width="135" x="100" y="40" as="geometry" />
