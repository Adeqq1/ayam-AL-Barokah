<mxfile host="Electron" agent="5.0 (Windows)">
  <diagram id="activity-pelanggan-keranjang" name="Activity Diagram Kelola Keranjang">
    <mxGraphModel dx="1046" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Swimlane Pool -->
        <mxCell id="swimlane_pool" value="Activity Diagram: Tambah ke Keranjang (Pelanggan)" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=40;swimlaneFillColor=#FFFFFF;fontStyle=1;align=center;fontSize=14;strokeWidth=2;rounded=1;arcSize=10;fontFamily=Times New Roman;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="700" height="760" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Pelanggan -->
        <mxCell id="swimlane_pelanggan" value="Pelanggan" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="0" y="40" width="320" height="720" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Sistem -->
        <mxCell id="swimlane_sistem" value="Sistem" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="320" y="40" width="380" height="720" as="geometry" />
        </mxCell>
        
        <!-- Start State -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="swimlane_pelanggan">
          <mxGeometry x="150" y="30" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Pilih & Klik -->
        <mxCell id="act_pilih" value="Mengeklik Tombol + Tambah ke Keranjang" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_pelanggan">
          <mxGeometry x="70" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Kirim GET -->
        <mxCell id="act_kirim" value="Mengirim Permintaan GET dengan ID Menu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Validasi Database -->
        <mxCell id="act_validasi" value="Memvalidasi Keberadaan &amp; Status Ketersediaan Menu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="160" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision: Apakah Tersedia? -->
        <mxCell id="dec_status" value="Apakah Menu Tersedia?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="120" y="240" width="140" height="80" as="geometry" />
        </mxCell>
        
        <!-- Action: Pesan Error -->
        <mxCell id="act_err" value="Menampilkan Pesan Menu Habis / Tidak Valid" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="10" y="350" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State: Error -->
        <mxCell id="end_err" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="80" y="430" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Cek Session -->
        <mxCell id="act_check_session" value="Memeriksa Status Sesi Keranjang Belanja" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="190" y="350" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision: Apakah Ada? -->
        <mxCell id="dec_exist" value="Apakah Menu Sudah Ada di Keranjang?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=10;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="210" y="430" width="140" height="80" as="geometry" />
        </mxCell>
        
        <!-- Action: Inkremen (+1) -->
        <mxCell id="act_inc" value="Menambah Jumlah Porsi Menu (+1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="140" y="540" width="110" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Set 1 -->
        <mxCell id="act_new" value="Menambahkan Menu ke Keranjang dengan Kuantitas 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="260" y="540" width="110" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Redirect -->
        <mxCell id="act_redirect" value="Redirect Kembali ke index.php dengan Status Sukses" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="620" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Tampilkan Notif -->
        <mxCell id="act_notif" value="Menampilkan Notifikasi Sukses &amp; Memperbarui Jumlah Kuantitas di Navigasi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_pelanggan">
          <mxGeometry x="70" y="620" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State -->
        <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="swimlane_pelanggan">
          <mxGeometry x="150" y="700" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <!-- Start -> Pilih -->
        <mxCell id="edge_start_pilih" edge="1" parent="1" source="start" target="act_pilih" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Pilih -> Kirim -->
        <mxCell id="edge_pilih_kirim" edge="1" parent="1" source="act_pilih" target="act_kirim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Kirim -> Validasi -->
        <mxCell id="edge_kirim_val" edge="1" parent="1" source="act_kirim" target="act_validasi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Validasi -> DB? -->
        <mxCell id="edge_val_db" edge="1" parent="1" source="act_validasi" target="dec_status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- DB? -> Error (Tidak) -->
        <mxCell id="edge_db_tidak" edge="1" parent="1" source="dec_status" target="act_err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value="Tidak">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Error -> End Error -->
        <mxCell id="edge_err_end" edge="1" parent="1" source="act_err" target="end_err" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- DB? -> Session (Ya) -->
        <mxCell id="edge_db_ya" edge="1" parent="1" source="dec_status" target="act_check_session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" value="Ya">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Session -> Exist? -->
        <mxCell id="edge_session_exist" edge="1" parent="1" source="act_check_session" target="dec_exist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Exist? -> Inc (Ya) -->
        <mxCell id="edge_exist_ya" edge="1" parent="1" source="dec_exist" target="act_inc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value="Ya">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Exist? -> New (Tidak) -->
        <mxCell id="edge_exist_tidak" edge="1" parent="1" source="dec_exist" target="act_new" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" value="Tidak">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Inc -> Redirect -->
        <mxCell id="edge_inc_redir" edge="1" parent="1" source="act_inc" target="act_redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- New -> Redirect -->
        <mxCell id="edge_new_redir" edge="1" parent="1" source="act_new" target="act_redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Redirect -> Notif (Cross Lane) -->
        <mxCell id="edge_redir_notif" edge="1" parent="1" source="act_redirect" target="act_notif" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Notif -> End -->
        <mxCell id="edge_notif_end" edge="1" parent="1" source="act_notif" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
