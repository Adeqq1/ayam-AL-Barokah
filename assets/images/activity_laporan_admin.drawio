<mxfile host="Electron" agent="5.0 (Windows)">
  <diagram id="activity-admin-laporan" name="Activity Diagram Laporan Penjualan">
    <mxGraphModel dx="1046" dy="845" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Swimlane Pool -->
        <mxCell id="swimlane_pool" value="Activity Diagram: Melihat Laporan Penjualan" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=40;swimlaneFillColor=#FFFFFF;fontStyle=1;align=center;fontSize=14;strokeWidth=2;rounded=1;arcSize=10;fontFamily=Times New Roman;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="700" height="700" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Admin -->
        <mxCell id="swimlane_admin" value="Admin" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="0" y="40" width="320" height="660" as="geometry" />
        </mxCell>
        
        <!-- Swimlane: Sistem -->
        <mxCell id="swimlane_sistem" value="Sistem" style="shape=swimlane;whiteSpace=wrap;html=1;startSize=30;align=center;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontStyle=1;fontSize=12;fontColor=#000000;" vertex="1" parent="swimlane_pool">
          <mxGeometry x="320" y="40" width="380" height="660" as="geometry" />
        </mxCell>
        
        <!-- Start State -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="150" y="30" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Action: Akses Halaman -->
        <mxCell id="act_akses" value="Mengakses Halaman Laporan Penjualan (laporan.php)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="70" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Tampilkan Laporan Default -->
        <mxCell id="act_tampil" value="Menampilkan Laporan Penjualan Default (Awal Bulan s/d Hari Ini)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="100" y="80" width="180" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision: Memilih Aksi -->
        <mxCell id="dec_aksi" value="Memilih Aksi?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=11;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="90" y="160" width="140" height="80" as="geometry" />
        </mxCell>
        
        <!-- ================= PATH A: FILTER LAPORAN ================= -->
        <!-- Action: Isi Tanggal & Filter -->
        <mxCell id="act_filter" value="Mengubah Rentang Tanggal &amp; Mengeklik Filter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="10" y="270" width="140" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Proses Filter -->
        <mxCell id="act_proses_filter" value="Mengambil Data &amp; Menampilkan Laporan Terfilter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="10" y="350" width="170" height="50" as="geometry" />
        </mxCell>
        
        <!-- ================= PATH B: CETAK LAPORAN ================= -->
        <!-- Action: Klik Cetak -->
        <mxCell id="act_cetak" value="Mengeklik Tombol Cetak Laporan" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="170" y="270" width="140" height="50" as="geometry" />
        </mxCell>
        
        <!-- Action: Jendela Cetak -->
        <mxCell id="act_print" value="Membuka Jendela Cetak Browser (window.print())" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;fontColor=#000000;align=center;" vertex="1" parent="swimlane_sistem">
          <mxGeometry x="200" y="350" width="170" height="50" as="geometry" />
        </mxCell>
        
        <!-- End State -->
        <mxCell id="end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=1.5;" vertex="1" parent="swimlane_admin">
          <mxGeometry x="150" y="600" width="20" height="20" as="geometry" />
        </mxCell>
        
        <!-- Edges -->
        <!-- Start -> Akses -->
        <mxCell id="edge_start_akses" edge="1" parent="1" source="start" target="act_akses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Akses -> Tampil -->
        <mxCell id="edge_akses_tampil" edge="1" parent="1" source="act_akses" target="act_tampil" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Tampil -> Aksi? -->
        <mxCell id="edge_tampil_aksi" edge="1" parent="1" source="act_tampil" target="dec_aksi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry">
            <Array points="340,105;340,145;220,145;220,170" />
          </mxGeometry>
        </mxCell>
        
        <!-- Aksi? -> Filter -->
        <mxCell id="edge_aksi_filter" edge="1" parent="1" source="dec_aksi" target="act_filter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" value="Filter Tanggal">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Filter -> Proses Filter -->
        <mxCell id="edge_filter_proses" edge="1" parent="1" source="act_filter" target="act_proses_filter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Proses Filter -> Tampil (Loop back) -->
        <mxCell id="edge_proses_tampil" edge="1" parent="1" source="act_proses_filter" target="act_tampil" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array points="565,450;450,450;450,145;570,145" />
          </mxGeometry>
        </mxCell>
        
        <!-- Aksi? -> Cetak -->
        <mxCell id="edge_aksi_cetak" edge="1" parent="1" source="dec_aksi" target="act_cetak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" value="Cetak Laporan">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        
        <!-- Cetak -> Jendela Cetak -->
        <mxCell id="edge_cetak_print" edge="1" parent="1" source="act_cetak" target="act_print" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Jendela Cetak -> Tampil (Loop back) -->
        <mxCell id="edge_print_tampil" edge="1" parent="1" source="act_print" target="act_tampil" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array points="755,450;800,450;800,145;650,145" />
          </mxGeometry>
        </mxCell>
        
        <!-- Aksi? -> Selesai -->
        <mxCell id="edge_aksi_selesai" edge="1" parent="1" source="dec_aksi" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="Selesai">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
